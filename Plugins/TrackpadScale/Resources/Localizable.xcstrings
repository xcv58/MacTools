    "state.noContact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep one finger lightly touching the trackpad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持一根手指轻触触控板。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühren Sie das Trackpad leicht mit einem Finger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un dedo en contacto suave con el trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un doigt en contact léger avec le trackpad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um dedo tocando levemente o trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко касайтесь трекпада одним пальцем."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指1本でトラックパッドに軽く触れ続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락 하나로 트랙패드를 가볍게 터치한 상태를 유지하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持一根手指輕觸觸控板。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ إصبعًا واحدًا يلامس لوحة التتبع برفق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad’e bir parmağınızla hafifçe dokunmaya devam edin."
          }
        }
      }
    },
    "state.multipleContacts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple contacts detected. Keep only one finger and tare again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到多个触点。请只保留一根手指，然后重新归零。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Kontakte erkannt. Lassen Sie nur einen Finger aufliegen und tarieren Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectaron varios contactos. Deja solo un dedo y vuelve a tarar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs contacts détectés. Gardez un seul doigt et tarez à nouveau."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários contatos detectados. Mantenha apenas um dedo e tare novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружено несколько касаний. Оставьте один палец и снова обнулите показания."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の接触を検出しました。指を1本だけにして、再度ゼロ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 접촉이 감지되었습니다. 손가락 하나만 유지하고 영점을 다시 조정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到多個觸點。請只保留一根手指，然後重新歸零。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف عدة نقاط لمس. أبقِ إصبعًا واحدًا فقط وصفّر مجددًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla temas algılandı. Yalnızca bir parmak bırakın ve yeniden sıfırlayın."
          }
        }
      }
    },
    "state.needsTare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for stability, then tare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待读数稳定，然后归零。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie auf Stabilität und tarieren Sie dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que se estabilice y tara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la stabilité, puis tarez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a estabilidade e tare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь стабильности и обнулите показания."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定してからゼロ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안정될 때까지 기다린 다음 영점을 조정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等讀數穩定，然後歸零。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر الاستقرار ثم صفّر القراءة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kararlı olmasını bekleyin, ardından sıfırlayın."
          }
        }
      }
    },
    "state.measuring": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your finger position and pressure steady. Readings are approximate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持手指位置和力度不变；读数仅供参考。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Fingerposition und Druck konstant. Die Werte sind Schätzungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén constantes la posición y la presión del dedo. Las lecturas son aproximadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la position et la pression du doigt constantes. Les mesures sont approximatives."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a posição e a pressão do dedo constantes. As leituras são aproximadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте положение пальца и силу нажатия. Показания приблизительные."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指の位置と圧力を一定に保ってください。表示は概算です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락 위치와 압력을 일정하게 유지하세요. 측정값은 대략적인 값입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持手指位置和力度不變；讀數僅供參考。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على موضع إصبعك وضغطه ثابتين. القراءات تقريبية."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmağınızın konumunu ve basıncını sabit tutun. Okumalar yaklaşık değerlerdir."
          }
        }
      }
    },
    "state.invalidSample": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid pressure reading. Lightly touch again and tare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压力读数无效。请重新轻触并归零。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Druckwert. Berühren Sie das Trackpad erneut leicht und tarieren Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectura de presión no válida. Vuelve a tocar suavemente y tara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure de pression invalide. Touchez à nouveau légèrement et tarez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitura de pressão inválida. Toque levemente novamente e tare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимые показания давления. Снова легко коснитесь трекпада и обнулите показания."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧力値が無効です。再度軽く触れ、ゼロ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 압력 값입니다. 다시 가볍게 터치하고 영점을 조정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓力讀數無效。請重新輕觸並歸零。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة الضغط غير صالحة. المس برفق مجددًا وصفّر القراءة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz basınç okuması. Yeniden hafifçe dokunun ve sıfırlayın."
          }
        }
      }
    },
    "state.interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session interrupted. Start again and tare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已中断。请重新开始并归零。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung unterbrochen. Starten Sie erneut und tarieren Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión interrumpida. Inicia de nuevo y tara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session interrompue. Redémarrez et tarez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão interrompida. Inicie novamente e tare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс прерван. Начните заново и обнулите показания."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが中断しました。再度開始し、ゼロ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 중단되었습니다. 다시 시작하고 영점을 조정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段已中斷。請重新開始並歸零。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطعت الجلسة. ابدأ مجددًا وصفّر القراءة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum kesintiye uğradı. Yeniden başlatın ve sıfırlayın."
          }
        }
      }
    },
