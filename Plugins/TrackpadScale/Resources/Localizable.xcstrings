        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置校準"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة الضبط"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırla"
          }
        }
      }
    },
    "uncalibrated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncalibrated: raw pressure difference is only an empirical estimate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未校准：原始压力差仅作为经验估算。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht kalibriert: Die rohe Druckdifferenz liefert nur eine empirische Schätzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin calibrar: la diferencia de presión sin procesar es solo una estimación empírica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non étalonné : la différence de pression brute n’est qu’une estimation empirique."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem calibração: a diferença de pressão bruta é apenas uma estimativa empírica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без калибровки: разница необработанного давления — лишь эмпирическая оценка."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未校正：生の圧力差は経験的な推定にすぎません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정되지 않음: 원시 압력 차이는 경험적인 추정값일 뿐입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未校準：原始壓力差僅作為經驗估算。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير معاير: فرق الضغط الخام مجرد تقدير تجريبي."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibre edilmedi: ham basınç farkı yalnızca deneysel bir tahmindir."
          }
        }
      }
    },
    "calibrated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrated: accuracy is still not guaranteed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已校准：校准仍不能保证准确度。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibriert: Die Genauigkeit ist weiterhin nicht garantiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrado: la precisión sigue sin estar garantizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étalonné : la précision reste sans garantie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrado: a precisão ainda não é garantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откалибровано: точность по-прежнему не гарантируется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "校正済み：精度は引き続き保証されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정됨: 정확도는 여전히 보장되지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已校準：校準仍不能保證準確度。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت المعايرة: لا تزال الدقة غير مضمونة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibre edildi: doğruluk yine de garanti edilmez."
          }
        }
      }
    },
    "temporaryCalibration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device identity unavailable; calibration lasts only for this session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备标识不可用，校准仅在本次会话有效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätekennung nicht verfügbar; die Kalibrierung gilt nur für diese Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidad del dispositivo no disponible; la calibración solo dura esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identité de l’appareil indisponible ; l’étalonnage ne vaut que pour cette session."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidade do dispositivo indisponível; a calibração dura apenas esta sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор устройства недоступен; калибровка действует только в этом сеансе."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの識別情報がないため、校正はこのセッションのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 식별 정보를 사용할 수 없어 보정은 이 세션에서만 유효합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置識別碼無法使用，校準僅在本次工作階段有效。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هوية الجهاز غير متاحة؛ المعايرة صالحة لهذه الجلسة فقط."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt kimliği kullanılamıyor; kalibrasyon yalnızca bu oturum için geçerlidir."
          }
        }
      }
    },
    "calibrationError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid weight from 1–100 g and wait for a stable reading with the object before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 1–100 g 的有效重量，并等待有物件的读数稳定后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein gültiges Gewicht von 1–100 g ein und warten Sie auf eine stabile Anzeige mit dem Gegenstand, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un peso válido de 1–100 g y espera a una lectura estable con el objeto antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un poids valide de 1–100 g et attendez une mesure stable avec l’objet avant de réessayer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um peso válido de 1–100 g e aguarde uma leitura estável com o objeto antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите допустимый вес от 1 до 100 г и дождитесь стабильных показаний с предметом, затем повторите попытку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1–100 gの有効な重量を入力し、物を置いた状態で安定してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1–100 g의 유효한 무게를 입력하고 물체를 올린 상태에서 값이 안정되면 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 1–100 g 的有效重量，並等待有物件的讀數穩定後重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل وزنًا صالحًا من 1 إلى 100 غ وانتظر قراءة مستقرة مع الجسم قبل المحاولة مجددًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–100 g arasında geçerli bir ağırlık girin ve yeniden denemeden önce nesneyle kararlı bir okuma bekleyin."
          }
        }
      }
    },
    "safeUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently place small objects only. No sharp or heavy items. Do not use for critical measurements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅轻放小物件，勿用尖锐或重物。不可用于关键测量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie nur kleine Gegenstände vorsichtig auf. Keine scharfen oder schweren Gegenstände. Nicht für kritische Messungen verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca solo objetos pequeños con cuidado. No uses objetos afilados ni pesados. No lo uses para mediciones críticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez doucement uniquement de petits objets. Aucun objet lourd ou pointu. Ne pas utiliser pour des mesures critiques."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque apenas objetos pequenos com cuidado. Não use itens afiados ou pesados. Não use para medições críticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осторожно кладите только небольшие предметы. Не используйте острые или тяжёлые предметы. Не используйте для критически важных измерений."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小物だけをそっと置いてください。鋭利な物や重い物は使わないでください。重要な測定には使用しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 물체만 살짝 올리세요. 날카롭거나 무거운 물체는 사용하지 마세요. 중요한 측정에 사용하지 마세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅輕放小物件，勿用尖銳或重物。不可用於關鍵測量。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع أجسامًا صغيرة فقط برفق. لا تستخدم أجسامًا حادة أو ثقيلة. لا تستخدمه للقياسات الحرجة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca küçük nesneleri nazikçe yerleştirin. Keskin veya ağır nesneler kullanmayın. Kritik ölçümler için kullanmayın."
          }
        }
      }
    },
    "limitations": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in Force Touch trackpads only. MacTools trackpad gestures pause while weighing and resume on stop or closing this page. Uses private macOS APIs; compatibility may change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持内置 Force Touch 触控板。称重时暂停 MacTools 触控板手势；停止或关闭页面后恢复。依赖 macOS 私有 API，兼容性可能变化。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur integrierte Force Touch Trackpads. MacTools-Trackpad-Gesten pausieren beim Wiegen und werden nach dem Stoppen oder Schließen dieser Seite fortgesetzt. Verwendet private macOS-APIs; die Kompatibilität kann sich ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo trackpads Force Touch integrados. Los gestos de MacTools se pausan al pesar y se reanudan al detener o cerrar esta página. Usa API privadas de macOS; la compatibilidad puede cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpads Force Touch intégrés uniquement. Les gestes MacTools sont suspendus pendant la pesée et reprennent à l’arrêt ou à la fermeture de cette page. Utilise des API privées de macOS ; la compatibilité peut changer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas trackpads Force Touch integrados. Os gestos do MacTools pausam durante a pesagem e retornam ao parar ou fechar esta página. Usa APIs privadas do macOS; a compatibilidade pode mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только встроенные трекпады Force Touch. Жесты MacTools приостанавливаются при взвешивании и возобновляются после остановки или закрытия страницы. Используются частные API macOS; совместимость может измениться."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵Force Touchトラックパッドのみ対応。計量中はMacToolsのトラックパッドジェスチャが一時停止し、停止またはページを閉じると再開します。macOSの非公開APIを使用しているため、互換性は変わる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 Force Touch 트랙패드만 지원합니다. 측정 중에는 MacTools 트랙패드 제스처가 일시 중지되며 중지하거나 이 페이지를 닫으면 재개됩니다. macOS 비공개 API를 사용하므로 호환성이 변경될 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支援內建 Force Touch 觸控板。稱重時暫停 MacTools 觸控板手勢；停止或關閉頁面後恢復。依賴 macOS 私有 API，相容性可能變更。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لوحات Force Touch المدمجة فقط. تتوقف إيماءات MacTools أثناء الوزن وتستأنف عند الإيقاف أو إغلاق الصفحة. يستخدم واجهات macOS خاصة؛ قد يتغير التوافق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yerleşik Force Touch trackpad’ler. MacTools hareketleri tartım sırasında duraklatılır, durdurulduğunda veya bu sayfa kapatıldığında devam eder. Özel macOS API’lerini kullanır; uyumluluk değişebilir."
          }
        }
      }
    },
